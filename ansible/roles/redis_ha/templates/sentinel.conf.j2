### {{ ansible_managed }}
### ⚠ 이 파일은 최초 1회만 배치된다. 이후 Sentinel 이 런타임에 직접 다시 쓰므로
###   (승격 결과·발견한 peer 목록 등) Ansible 이 다시 덮어쓰면 안 된다.
###   강제로 다시 쓰려면 -e redis_sentinel_force_rewrite=true (학습 상태 초기화됨).

port {{ redis_sentinel_port }}
### ⚠ bind 의 '첫 주소'가 나가는 연결의 소스 주소이자 자기 자신을 광고하는 주소로 쓰인다.
###   127.0.0.1 을 앞에 두면 (1) 원격 redis 로 향하는 연결이 전부 실패하고
###   (2) 다른 Sentinel 에게 자기를 127.0.0.1:26379 로 알려 서로를 발견하지 못한다
###   → num-other-sentinels 가 0 에 머물러 정족수를 못 채우고 페일오버가 영원히 일어나지 않는다.
bind {{ node_ip }} 127.0.0.1
# 광고 주소를 명시해 bind 순서에 의존하지 않게 한다(이중 안전장치).
sentinel announce-ip {{ node_ip }}
sentinel announce-port {{ redis_sentinel_port }}
protected-mode no
daemonize no
pidfile /run/redis/sentinel.pid
logfile /var/log/redis/sentinel.log
dir /var/lib/redis

{% if redis_sentinel_auth_enabled %}
requirepass {{ vault_redis_password }}
{% endif %}

# monitor 는 반드시 아래 sentinel 지시자들보다 먼저 와야 한다.
sentinel monitor {{ redis_sentinel_master_name }} {{ hostvars[_redis_initial_master].node_ip }} {{ redis_port }} {{ redis_sentinel_quorum }}
sentinel auth-pass {{ redis_sentinel_master_name }} {{ vault_redis_password }}
sentinel down-after-milliseconds {{ redis_sentinel_master_name }} {{ redis_sentinel_down_after_ms }}
sentinel failover-timeout {{ redis_sentinel_master_name }} {{ redis_sentinel_failover_timeout_ms }}
# 동시에 재동기화할 replica 수. 1 이면 순차 — 페일오버 중에도 읽기 가용성이 유지된다.
sentinel parallel-syncs {{ redis_sentinel_master_name }} 1
sentinel resolve-hostnames no
