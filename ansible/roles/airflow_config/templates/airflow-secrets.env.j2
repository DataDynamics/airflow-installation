### {{ ansible_managed }}
### 모드 600. systemd EnvironmentFile 로 서비스에 주입된다.
###
### ⚠ 값은 반드시 작은따옴표로 감싼다.
###   · BROKER_URL 은 Sentinel 목록을 ';' 로 잇는데, 감싸지 않으면 이 파일을
###     `set -a; . airflow-secrets.env` 로 source 할 때 bash 가 ';' 를 명령 구분자로
###     해석해 뒷부분을 실행하려 든다.
###   · SENTINEL_KWARGS 는 JSON 이라 큰따옴표를 품는데, 감싸지 않으면 bash 가 그것을
###     벗겨내 {password:pw} 라는 잘못된 JSON 이 되고 Airflow 가
###     'sentinel_kwargs should be written in the correct dictionary format' 로 거부한다.
###   systemd 는 셸 파싱을 하지 않아 따옴표가 없어도 동작하지만, 점검·디버깅 때
###   사람이 source 하는 일이 잦으므로 양쪽에서 안전하도록 감싼다
###   (systemd 도 따옴표를 인식해 벗겨내므로 값에 그대로 들어가지 않는다).
###
### ⚠ fernet/secret/jwt 3종은 전 노드가 동일해야 한다.
###   특히 JWT 가 다르면 워커가 Execution API 에서 401 을 받는다.

# 메타DB — 로컬 airflow-haproxy(:{{ airflow_db_port }}) → Patroni Leader 의 PostgreSQL 직결.
# (pgbouncer 를 거치지 않는다 — group_vars 주석 참조)
# 비밀번호는 percent-encoding 한다(특수문자가 있으면 URL 파서가 깨진다).
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN='postgresql+psycopg2://{{ airflow_db_user }}:{{ vault_db_password | urlencode }}@{{ airflow_db_host }}:{{ airflow_db_port }}/{{ airflow_db_name }}?sslmode={{ airflow_db_sslmode }}'

AIRFLOW__CORE__FERNET_KEY='{{ vault_fernet_key }}'
AIRFLOW__API__SECRET_KEY='{{ vault_api_secret_key }}'
AIRFLOW__API_AUTH__JWT_SECRET='{{ vault_jwt_secret }}'

# Celery 브로커 — Sentinel 목록. 세미콜론으로 구분하며, URL 의 비밀번호는
# Redis 데이터 커넥션용이다(Sentinel 자체 인증은 아래 sentinel_kwargs).
AIRFLOW__CELERY__BROKER_URL='{% for h in groups['redis_sentinel'] %}sentinel://:{{ vault_redis_password | urlencode }}@{{ hostvars[h].node_ip }}:{{ redis_sentinel_port }}{{ ';' if not loop.last else '' }}{% endfor %}'

# 결과 백엔드는 메타DB 재사용(브로커와 분리).
AIRFLOW__CELERY__RESULT_BACKEND='db+postgresql://{{ airflow_db_user }}:{{ vault_db_password | urlencode }}@{{ airflow_db_host }}:{{ airflow_db_port }}/{{ airflow_db_name }}?sslmode={{ airflow_db_sslmode }}'
{% if redis_sentinel_auth_enabled %}
# Sentinel 접속 인증.
AIRFLOW__CELERY_BROKER_TRANSPORT_OPTIONS__SENTINEL_KWARGS='{"password":"{{ vault_redis_password }}"}'
{% endif %}
