### {{ ansible_managed }}
### 비밀(DB비번/fernet/secret/jwt/broker/result)은 이 파일에 두지 않는다.
### {{ airflow_home }}/airflow-secrets.env (600) 에서 AIRFLOW__SECTION__KEY 환경변수로 주입된다.

[core]
executor = CeleryExecutor
auth_manager = airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
dags_folder = {{ airflow_home }}/dags
plugins_folder = {{ airflow_home }}/plugins
default_timezone = {{ airflow_default_timezone }}
load_examples = {{ airflow_load_examples | ternary('True', 'False') }}
dags_are_paused_at_creation = {{ airflow_dags_paused_at_creation | ternary('True', 'False') }}
default_task_retries = {{ airflow_default_task_retries }}
dagbag_import_timeout = {{ airflow_dagbag_import_timeout }}
parallelism = {{ airflow_parallelism }}
max_active_tasks_per_dag = {{ airflow_max_active_tasks_per_dag }}
max_active_runs_per_dag = {{ airflow_max_active_runs_per_dag }}
# 워커는 LB 를 거치지 않고 '자기 노드' api-server 를 호출한다.
# 중앙 api-server 를 지정하면 그 노드가 전체 태스크 실행의 단일 장애점이 된다.
execution_api_server_url = {{ airflow_execution_api_url }}

[database]
# 실제 접속 문자열은 secrets env 로 주입. 평시 경로는
{% if airflow_db_backend == 'patroni' %}
# 로컬 airflow-haproxy({{ airflow_db_host }}:{{ airflow_db_port }}) → 현재 Patroni Leader 의 PostgreSQL 직결.
# pgbouncer 를 거치지 않으므로 풀링은 전적으로 여기 설정이 담당한다.
{% else %}
# {{ airflow_db_host }}:{{ airflow_db_port }} (external) 직접 접속. 중간 풀러가 없다면
# 풀링은 전적으로 여기 설정이 담당한다.
{% endif %}
sql_alchemy_pool_size = {{ airflow_sql_pool_size }}
sql_alchemy_max_overflow = {{ airflow_sql_max_overflow }}
sql_alchemy_pool_recycle = {{ airflow_sql_pool_recycle }}
# HAProxy 가 on-marked-down shutdown-sessions 로 페일오버 시 커넥션을 강제 종료한다.
# pre_ping 이 없으면 그 순간 죽은 커넥션을 그대로 써서 태스크가 실패한다.
sql_alchemy_pool_pre_ping = {{ airflow_sql_pool_pre_ping | ternary('True', 'False') }}

[scheduler]
scheduler_heartbeat_sec = {{ airflow_scheduler_heartbeat_sec }}
catchup_by_default = False
max_tis_per_query = {{ airflow_max_tis_per_query }}

[dag_processor]
parsing_processes = {{ airflow_parsing_processes }}
min_file_process_interval = {{ airflow_min_file_process_interval }}
refresh_interval = {{ airflow_dag_dir_refresh_interval }}
dag_file_processor_timeout = {{ airflow_dag_file_processor_timeout }}

[celery]
worker_concurrency = {{ airflow_worker_concurrency }}

[celery_broker_transport_options]
# Sentinel 로 master 를 찾기 위한 논리 이름. sentinel.conf 의 monitor 이름과 같아야 한다.
master_name = {{ redis_sentinel_master_name }}

[logging]
base_log_folder = {{ airflow_home }}/logs
logging_level = {{ airflow_logging_level }}
# 다른 노드에서 실행된 태스크 로그를 UI 가 여기로 가져간다.
# 노드 hostname 이 상호 resolve 되지 않으면 로그가 보이지 않는다(/etc/hosts 등록됨).
worker_log_server_port = {{ airflow_worker_log_port }}

[api]
host = 0.0.0.0
port = {{ airflow_api_port }}
workers = {{ airflow_api_workers }}
worker_timeout = {{ airflow_api_worker_timeout }}
# 운영자에게 노출되는 주소는 LB(VIP:{{ airflow_lb_port }}) 다.
base_url = {{ airflow_base_url }}
expose_config = {{ airflow_expose_config }}
expose_stacktrace = False
instance_name = {{ airflow_instance_name }}
