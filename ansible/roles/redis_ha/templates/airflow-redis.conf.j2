### {{ ansible_managed }}
### Airflow 브로커용 정적 설정. /etc/redis/redis.conf 의 마지막에서 include 되므로
### 여기 값이 최종적으로 이긴다.
###
### ⚠ replicaof 를 여기에 두지 말 것 — Sentinel 이 페일오버로 승격시킨 결과를
###   이 파일이 덮어써서 되돌려 버린다. 복제 관계는 런타임 명령으로만 부트스트랩한다.

### ⚠ bind 의 '첫 주소'가 나가는 연결의 소스 주소로도 쓰인다.
###   127.0.0.1 을 앞에 두면 원격 노드로 향하는 연결이 loopback 소스로 나가 전부 실패한다
###   (Sentinel 이 다른 노드의 redis 를 영원히 s_down 으로 보는 원인이었다).
###   반드시 노드 IP 를 먼저 쓴다.
bind {{ node_ip }} 127.0.0.1
port {{ redis_port }}
protected-mode no

# master 가 replica 를 보고할 때 실제 IP 를 쓰도록 명시(Sentinel 이 이 값으로 접속한다).
replica-announce-ip {{ node_ip }}

# 인증 — master/replica 양방향 모두 필요(페일오버로 역할이 바뀌므로 둘 다 설정).
requirepass {{ vault_redis_password }}
masterauth {{ vault_redis_password }}

replica-read-only yes
replica-serve-stale-data yes

# 브로커는 메시지를 버리면 태스크가 사라진다 — eviction 금지.
maxmemory-policy {{ redis_maxmemory_policy }}

# Celery 브로커는 영속화가 필수는 아니지만, 재기동 시 미처리 큐를 살리려면 AOF 가 안전하다.
appendonly {{ 'yes' if (redis_appendonly | default(true) | bool) else 'no' }}
appendfsync everysec
